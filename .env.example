# ---------------------------------------------
# OpenViz root environment template
# ---------------------------------------------

# Preferred secure mode: call AI through the proxy
VITE_AI_PROXY_URL=https://openviz-ai-proxy.your-subdomain.workers.dev
VITE_AI_PROXY_AUTH_TOKEN=your_openviz_proxy_auth_token_here
VITE_AI_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Keep disabled by default
VITE_ALLOW_INSECURE_DIRECT_AI=false

# Optional local-only direct provider mode (insecure)
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VITE_AI_PROVIDER_ORDER=groq,openai,anthropic
